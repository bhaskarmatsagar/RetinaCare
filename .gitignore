# =====================================================================
# RetinaCare AI Pipeline - Git Ignore
# =====================================================================

# --- Python Environment & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- IDEs & Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- OS Artifacts ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Logging & Runtime Temp ---
logs/
*.log
artifacts/matplotlib_cache/

# =====================================================================
# Large Datasets & Raw Image Archives (Strictly Do Not Commit)
# =====================================================================
AGAR300*/
aptos2019*/
archive*/
datasets/
raw_data/
data/raw/
data/derived/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# =====================================================================
# Generated Artifacts & Large Binary Files (>100MB / Multi-GB Outputs)
# =====================================================================
# Full preprocessed images and multi-panel overlays (~3.1 GB)
artifacts/p2_preprocess/
artifacts/p6_fusion/

# Generated 2-page Clinician PDF reports (~3.2 GB)
artifacts/reports/*.pdf

# Individual runtime case state JSONs (regenerated via scripts/run_pipeline.py)
artifacts/cases/

# Phase-specific intermediate image masks (regenerated via pipeline)
artifacts/p3_anatomy/
artifacts/p4_lesion/
artifacts/p5_grading/
artifacts/p7_safety/

# Deep learning model weight checkpoints (Keras / PyTorch / TensorFlow)
artifacts/models/*.keras
artifacts/models/*/*.keras
*.h5
*.keras
*.pt
*.pth
*.onnx
*.tflite
*.ckpt
*.weights

# Keep directory structures and model cards
!artifacts/models/best_grading_model_card.json
!artifacts/env_snapshot.txt
!artifacts/**/.gitkeep
!data/metadata/
